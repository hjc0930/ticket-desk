{
  "name": "ticket-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run typecheck",
    "dev": "tsdown --watch --out-dir .tsdown-dev --on-success \"node --enable-source-maps .tsdown-dev/server.js\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "vitest run test",
    "test:watch": "vitest src",
    "build": "pnpm run typecheck && tsdown",
    "start": "node --enable-source-maps dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:local": "DATABASE_URL= JWT_SECRET=local-development-only-placeholder-at-least-32-chars SEED_ADMIN_USERNAME=admin SEED_ADMIN_PASSWORD=admin tsx src/db/seed.ts --local"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.4.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@fastify/type-provider-zod": "1.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.8",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.10",
    "openapi-types": "12.1.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pino-pretty": "^13.2.0",
    "tsdown": "0.23.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
